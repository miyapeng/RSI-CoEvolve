# Examples only. Export real values securely in your shell/job environment.
# This file is not auto-loaded. Never commit .env or actual credentials.
E2B_API_KEY=replace-with-your-sdk-key
E2B_DOMAIN=replace-with-your-tencent-domain
E2B_TEMPLATE=replace-with-your-approved-template
# Proxy mode reads http_proxy; direct mode does not pass a proxy argument.
http_proxy=http://your-approved-proxy:port
LLM_CENTER_API_KEY=replace-with-your-inference-key
PROPOSER_MODEL=replace-with-your-model-access-id
